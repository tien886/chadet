# Auth keys (RS256). Generate once:
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#   export CHADET_JWT_PRIVATE_KEY="$(base64 -w0 private.pem)"
#   export CHADET_JWT_PUBLIC_KEY="$(base64 -w0 public.pem)"
#
# Then load before running any service that signs/verifies JWTs:
#   set -a; source .env; set +a
# Or provide the two vars in the runtime environment directly.
#
# Copy this file to .env (gitignored) and fill in the values.

CHADET_JWT_PRIVATE_KEY=
CHADET_JWT_PUBLIC_KEY=